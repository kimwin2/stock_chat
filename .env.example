# 이 파일을 .env 로 복사한 뒤 값을 채우세요. .env 는 절대 커밋되지 않습니다.

# ── Gemini (필수) ─────────────────────────────────────────
# https://aistudio.google.com/apikey 에서 발급. 무료 등급 키를 쓰세요.
GEMINI_API_KEY=

# ── 텔레그램 (필수) ───────────────────────────────────────
# https://my.telegram.org 에서 발급
TG_API_ID=
TG_API_HASH=
# 최초 1회 `python -m pipeline.tg_auth` 로 발급받아 붙여넣기
TG_STRING_SESSION=

# ── 웹 공유 암호 (필수) ───────────────────────────────────
# 친구들에게 알려줄 암호. 이 값으로 데이터가 암호화됩니다.
SHARE_PASSPHRASE=

# ── UI '크롤링+요약' 버튼용 (선택) ────────────────────────
# GitHub fine-grained PAT. 권한은 이 레포의 Actions: Read and write 하나만.
# 비워두면 버튼이 비활성화되고 매일 자정 자동 실행만 동작합니다.
GH_DISPATCH_TOKEN=
GH_REPO=kimwin2/stock_chat
